# ---------------------------------------------------------------------------
# Environment overrides for the NBA Predictor platform.
#
# Every value here shadows the corresponding default in `constants.py`.
# Copy this file to `.env` (or export the variables in your process manager)
# and populate real credentials; never commit the populated file.
# ---------------------------------------------------------------------------

# ---- Primary inference gateway (structured prediction calls) ----
NBA_COMPLETION_API_KEY=
NBA_COMPLETION_ENDPOINT=https://api.aipaibox.com/v1/chat/completions
NBA_COMPLETION_MODEL=gpt-5.5

# ---- Retrieval gateway (hosted web search) ----
NBA_SEARCH_API_KEY=
NBA_SEARCH_ENDPOINT=https://api.deepseek.com/v1/responses
NBA_SEARCH_MODEL=deepseek-v4-flash

# ---- Filesystem ----
# NBA_DATASET_FILE=./nba_team_boxscores_features_2015_16_to_2025_26.csv
# NBA_ROSTER_FILE=./nba_teams_players.jsonl
# NBA_UPLOAD_DIR=./uploads
# NBA_TRAINED_MODEL_DIR=./trained_models

# ---- Server ----
NBA_HOST=0.0.0.0
NBA_PORT=3344
NBA_DEBUG=1

# ---- Limits ----
# NBA_MAX_UPLOAD_BYTES=16777216
# NBA_MAX_WORKERS=10
# NBA_TIMEOUT=120
# NBA_TIMEOUT_LONG=600
# NBA_SEARCH_FANOUT=6
# NBA_FORM_WINDOW=10
